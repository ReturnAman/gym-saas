// Prisma schema — database foundation.
//
// PostgreSQL datasource per ADR 002. The connection string lives in
// prisma.config.ts (Prisma 7+), sourced from the DATABASE_URL environment
// variable — never in this file.
//
// Domain models (organizations, members, memberships, attendance,
// payments, …) are intentionally NOT defined here; they arrive with their
// own implementation issues and migrations.
// See docs/04-DATABASE-DESIGN.md and docs/decisions/002-DATABASE-ORM.md.

// ---------------------------------------------------------------------------
// Schema conventions (ADR 012). Every future model MUST follow these.
// ---------------------------------------------------------------------------
// Naming:  PostgreSQL uses lowercase snake_case. Prisma models/fields use
//          PascalCase/camelCase in TypeScript and map explicitly:
//            model OrganizationMembership { ... @@map("organization_memberships") }
//            organizationId String @map("organization_id")
//          Tables are plural; the primary-key column is always `id`;
//          foreign keys are `<entity>_id` (e.g. organization_id, member_id).
//
// IDs:     Stable opaque generated identifiers — never phone numbers, never
//          sequential integers (ADR 012 §8–10; 04-DATABASE-DESIGN §44).
//          Standard primary key:
//
//            id String @id @default(uuid())
//
//          The UUID itself may serve as the API resource identifier; do not
//          invent a second public_id without a concrete requirement.
//
// Time:    Instants are UTC timestamptz (Prisma DateTime). Standard lifecycle
//          pair on every table:
//
//            createdAt DateTime @default(now()) @map("created_at")
//            updatedAt DateTime @updatedAt       @map("updated_at")
//
//          Domain instants use descriptive `_at` names (checked_in_at,
//          confirmed_at, …); calendar dates use `_date` (start_date,
//          end_date, …) as DateTime @db.Date — never ambiguous `date`/`time`.
//
// Money:   Exact types only — Decimal, never Float (ADR 011 §29).
//
// Enums:   Stable UPPERCASE values (PENDING, APPROVED, …), never UI labels.
//
// Template for new models:
//
//   model Example {
//     id             String   @id @default(uuid())
//     organizationId String   @map("organization_id")
//     createdAt      DateTime @default(now()) @map("created_at")
//     updatedAt      DateTime @updatedAt       @map("updated_at")
//
//     @@map("examples")
//   }
//
// Tenant-owned models MUST carry organizationId and queries MUST always
// filter by it (ADR 011 §21). Constraints and indexes follow the real query
// patterns of each feature — none are declared speculatively here.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Authentication foundation.
// ---------------------------------------------------------------------------
// The application User is the application's own identity record, distinct
// from the Clerk identity (ADR 001 §5, ADR 015 §5). Clerk proves *who* the
// person is; this row is the stable internal identity the domain will
// reference (organization memberships, members, …) in later issues.
//
// Identity rules (ADR 001 §6):
// - Primary key is an opaque generated UUID — never a phone number.
// - clerkUserId is the unique link to the Clerk identity, with a unique
//   constraint so repeated synchronization can never create duplicates.
// - Phone is deliberately NOT stored here and is NOT a unique key.
model User {
  id          String   @id @default(uuid())
  clerkUserId String   @unique @map("clerk_user_id")
  // Explicit timestamptz: Prisma's default PostgreSQL DateTime mapping is
  // `timestamp` (no time zone); the convention requires UTC timestamptz.
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  memberships OrganizationMembership[]

  // Member rows linked to this application user (set at OTP onboarding;
  // NULL until then). Named to avoid clashing with `memberships` above.
  linkedMembers Member[] @relation("LinkedMembers")

  // Payments this user confirmed, and audit events they performed.
  confirmedPayments Payment[] @relation("ConfirmedPayments")
  auditEvents       AuditLog[]

  @@map("users")
}

// ---------------------------------------------------------------------------
// Organization and owner onboarding foundation (ADR 010, ADR 011, ADR 015).
// ---------------------------------------------------------------------------
// Organization is the gym/business tenant. Only the minimum fields for the
// foundation are present (name comes from the onboarding form); gym profile
// fields (phone, email, address, status) arrive with their own issues per
// 04-DATABASE-DESIGN §7 ("additional settings may be added as the product
// evolves").
//
// OrganizationMembership is the authorization boundary between a User and an
// Organization (ADR 015 §14). Roles are application-owned and
// organization-scoped; the unique constraint on (user_id, organization_id)
// guarantees a user can never hold duplicate memberships in one
// organization.
model Organization {
  id        String   @id @default(uuid())
  name      String
  // Gym profile fields (ADR 010 §7). Nullable: the onboarding form only
  // collects the name; details are filled in later on the settings page.
  phone     String?
  email     String?
  address   String?
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  memberships OrganizationMembership[]

  members           Member[]
  memberMemberships Membership[]
  payments          Payment[]
  auditLogs         AuditLog[]

  @@map("organizations")
}

// Application-owned roles, organization-scoped (ADR 015 §15). Stable
// UPPERCASE values per the schema conventions; never UI labels.
enum Role {
  OWNER
  ADMIN
  TRAINER
  STAFF
  MEMBER
}

model OrganizationMembership {
  id             String   @id @default(uuid())
  userId         String   @map("user_id")
  organizationId String   @map("organization_id")
  role           Role     @default(MEMBER)
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([userId, organizationId])
  @@index([organizationId])
  @@map("organization_memberships")
}

// ---------------------------------------------------------------------------
// Member Management V1 foundation (04-DATABASE-DESIGN §9, §11).
// ---------------------------------------------------------------------------
// Member is the gym member as a business entity — a person, not necessarily
// an application User (a record may exist before the person onboards via
// OTP). userId is the optional future link set at OTP onboarding; it stays
// NULL until then. No status column: the product does not define a member
// lifecycle yet (deactivation is TBD, 17-PRODUCT-UX-SPEC §22); membership
// status is derived from dates instead. Phone is deliberately NOT unique
// per organization: duplicates are surfaced to the user for an explicit
// decision (keep/skip) and never silently merged or blocked at the DB.
//
// The composite unique on (organization_id, id) backs the composite foreign
// key from memberships: it is the database-level guarantee that a
// membership's organization always matches its member's organization
// (04-DATABASE-DESIGN §30).
model Member {
  id             String   @id @default(uuid())
  organizationId String   @map("organization_id")
  userId         String?  @map("user_id")
  name           String
  phoneNumber    String   @map("phone_number")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User?        @relation("LinkedMembers", fields: [userId], references: [id], onDelete: SetNull)
  memberships  Membership[]
  payments     Payment[]

  @@unique([organizationId, id])
  @@index([organizationId])
  @@index([organizationId, phoneNumber])
  @@map("members")
}

// Fixed V1 membership plans (product rule — not owner-configurable yet).
// Stable UPPERCASE values per the schema conventions; never UI labels.
enum MembershipPlan {
  MONTHLY
  THREE_MONTHS
  SIX_MONTHS
  TWELVE_MONTHS
}

// Membership is the member's actual membership period/entitlement —
// separate from Member by design (17-PRODUCT-UX-SPEC §11). Plans are a
// fixed V1 enum, not an owner-configurable table (product rule). The agreed
// fee is stored exactly (Decimal) and remains the membership's total
// charge for Payments V1 — there is deliberately no separate Charge model.
//
// There is deliberately NO paid_amount column: payments are separate
// records (see Payment below), and the finalized calculation is
// Outstanding = fee − SUM(confirmed payments). Paid/outstanding are always
// derived from the payment records, never a persisted balance (see
// deriveMembershipPayments in src/lib/members.ts).
//
// Tenant integrity is enforced at the database level, not just in
// application code: the composite foreign key
// (organization_id, member_id) → members(organization_id, id) guarantees a
// membership can never reference a member of a different organization.
// The composite unique on (organization_id, id) likewise backs the
// composite foreign keys from payments.
model Membership {
  id             String         @id @default(uuid())
  organizationId String         @map("organization_id")
  memberId       String         @map("member_id")
  plan           MembershipPlan
  startDate      DateTime       @map("start_date") @db.Date
  expiryDate     DateTime       @map("expiry_date") @db.Date
  fee            Decimal        @db.Decimal(12, 2)
  createdAt      DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime       @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  member       Member       @relation(fields: [organizationId, memberId], references: [organizationId, id], onDelete: Cascade)
  payments     Payment[]

  @@unique([organizationId, id])
  @@index([organizationId])
  @@index([memberId])
  @@map("memberships")
}

// ---------------------------------------------------------------------------
// Payments V1 (04-DATABASE-DESIGN §14, §16, §17) and audit foundation
// (ADR 017).
// ---------------------------------------------------------------------------
// Payment is a confirmed payment received by the gym — money moves directly
// between the member and the gym; the SaaS only records it. Member payment
// claims (04-DATABASE-DESIGN §13) are deliberately NOT modeled yet: member
// OTP onboarding/linking does not exist, so a member cannot submit a claim;
// claims arrive as a later slice. In V1 an authorized staff user records a
// payment that has actually been received (confirmedBy/confirmedAt).
//
// Confirmed payments are financial history: the application offers no edit
// or delete path for them, and corrections will use explicit
// reversal/adjustment records in a future slice — never silent rewrites.
//
// Tenant integrity mirrors Membership's: composite foreign keys
// (organization_id, member_id) → members(organization_id, id) and
// (organization_id, membership_id) → memberships(organization_id, id)
// guarantee a payment can never reference a member or membership of a
// different organization.
enum PaymentMethod {
  UPI
  CASH
  CARD
  OTHER
}

model Payment {
  id             String        @id @default(uuid())
  organizationId String        @map("organization_id")
  memberId       String        @map("member_id")
  membershipId   String        @map("membership_id")
  amount         Decimal       @db.Decimal(12, 2)
  paymentMethod  PaymentMethod @map("payment_method")
  // Optional free-text reference (e.g. a UPI transaction id) — recorded when
  // the gym has one; not required for any method in V1.
  reference      String?
  confirmedAt    DateTime      @map("confirmed_at") @db.Timestamptz(6)
  // The staff user who recorded/confirmed receipt of this payment.
  confirmedBy    String        @map("confirmed_by")
  createdAt      DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization  Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  member        Member       @relation(fields: [organizationId, memberId], references: [organizationId, id], onDelete: Cascade)
  membership    Membership   @relation(fields: [organizationId, membershipId], references: [organizationId, id], onDelete: Cascade)
  confirmedByUser User       @relation("ConfirmedPayments", fields: [confirmedBy], references: [id], onDelete: Restrict)

  @@index([organizationId])
  @@index([memberId])
  @@index([membershipId])
  @@map("payments")
}

// Minimal audit log (ADR 017). Append-only: events are facts about things
// that already happened, so there is no updated_at. `event` is a stable
// string code (e.g. PAYMENT_CONFIRMED), not an enum, so new event types do
// not require a schema migration; `metadata` carries event-specific detail
// as JSON. Only the events a slice actually emits are written — V1 writes
// PAYMENT_CONFIRMED, inside the same transaction as the payment itself.
model AuditLog {
  id             String   @id @default(uuid())
  organizationId String   @map("organization_id")
  actorUserId    String   @map("actor_user_id")
  event          String
  targetType     String   @map("target_type")
  targetId       String   @map("target_id")
  metadata       Json?
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  actor        User         @relation(fields: [actorUserId], references: [id], onDelete: Restrict)

  @@index([organizationId])
  @@index([organizationId, targetType, targetId])
  @@map("audit_logs")
}
