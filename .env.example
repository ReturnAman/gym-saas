# gym-saas environment configuration — placeholders only.
# Copy to .env.local and fill in real values locally. Never commit real secrets.
# See docs/decisions/018-CONFIGURATION-AND-ENVIRONMENT-STRATEGY.md.

# --- Application (needed for the foundation) ---
NODE_ENV=development
APP_URL=http://localhost:3000

# --- Database (needed for the foundation) ---
# PostgreSQL connection string. Treat as sensitive.
DATABASE_URL=postgresql://user:password@localhost:5432/gymsaas_dev

# --- Database pool (optional; the defaults below are the shipped values) ---
# Per-instance pool bounds, sized for a small PostgreSQL connection
# allowance (see src/lib/server/db.ts for the connection budget).
# Invalid values fail startup. Tune only with the budget in mind.
# DB_POOL_MAX=8
# DB_POOL_CONNECTION_TIMEOUT_MS=5000
# DB_POOL_IDLE_TIMEOUT_MS=30000
# DB_STATEMENT_TIMEOUT_MS=15000

# --- Authentication (Clerk is the auth provider; see docs/decisions/001-AUTHENTICATION.md) ---
# Standard Clerk variable names — the official @clerk/nextjs integration reads
# these directly. The publishable key is public by design; the secret key is
# sensitive and must never be committed or exposed to the browser.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=<redacted>

# --- Member OTP (optional; only needed when member OTP auth is used) ---
# 2Factor SMS OTP provider key. Server-side only; read lazily by the
# provider — the application runs without it when member OTP is unused.
# Sensitive: never commit a real value.
TWOFACTOR_API_KEY=<redacted>

# --- Observability (optional for now; provider not yet selected) ---
SENTRY_DSN=

# --- WhatsApp notifications (NOT needed for the foundation; future) ---
# Centralized sender; official Meta provider for production (see ADR 005).
WHATSAPP_PROVIDER=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# --- Feature flags (future) ---
ENABLE_WHATSAPP=false
ENABLE_ANALYTICS=false

# --- Platform administration (SaaS trial/subscription slice) ---
# Comma-separated stable Clerk user IDs allowed into /platform-admin.
# Server-side only; read by src/lib/server/platform-admin.ts. Missing,
# empty, or unparseable configuration fails closed: nobody is a platform
# administrator. Gym roles (OWNER/ADMIN/STAFF) never grant this access.
# Never commit a real user ID here; set it in the deployment environment.
# PLATFORM_ADMIN_CLERK_USER_IDS=user_abc,user_def
